          "http": {
            "method": "GET",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/loans/:id/project",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the loan's project details."
        },
        {
          "info": {
            "name": "Loan Projects Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/loans/:id/projects",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the loan's project details."
        },
        {
          "info": {
            "name": "Update Projects Info",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/loans/:id/projects",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }

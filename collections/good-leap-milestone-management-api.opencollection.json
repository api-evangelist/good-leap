{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoodLeap Developer Authorization & Elevation Management Milestone Management API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Milestone Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send Certificate of Project Completion (CPC) - HI only",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/loans/:id/cpc",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Sends loan CPC"
        },
        {
          "info": {
            "name": "Transition a Milestone",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/loans/:id/milestones",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Transition a loan to a client-provided milestone."
        }
      ]
    }
  ],
  "bundled": true
}
              },
              {
                "name": "inputs",
                "value": "",
                "type": "query"
              },
              {
                "name": "validation",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the loan's projects types."
        },
        {
          "info": {
            "name": "Loan Project Info",
            "type": "http"

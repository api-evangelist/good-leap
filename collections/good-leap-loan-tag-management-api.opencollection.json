{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoodLeap Developer Authorization & Elevation Management Loan Tag Management API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Loan Tag Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add Loan Tags",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/loans/:id/tags",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add loan tags to a loan."
        },
        {
          "info": {
            "name": "Delete Loan Tags",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/loans/:id/tags:batchDelete",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "batchDelete",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete loan tags from a loan."
        }
      ]
    }
  ],
  "bundled": true
}
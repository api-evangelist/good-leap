          "name": "Send Loan Documents",
          "request": {
            "name": "Send Loan Documents",
            "description": {
              "content": "A successful request will result in loan documents being sent to the borrower(s). \nThis can happen as one of two scenarios:\n1. If loan documents have yet to be signed, unsigned documents are sent.\n2. If loan documents have already been signed, a copy of the signed documents are re-sent. \n   The loan’s status will remain untouched.",
              "type": "text/plain"
            },

{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoodLeap Developer Authorization & Elevation Management Install Categories & Loan Limitations API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Install Categories & Loan Limitations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Install Categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/categories",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a collection of categories."
        },
        {
          "info": {
            "name": "All Loan min/max values for states and categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/categories/all/limitations",
            "params": [
              {
                "name": "states",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get categories limitations"
        },
        {
          "info": {
            "name": "Loan min/max values by category ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/categories/:id/limitations",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "states",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get category limitations"
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoodLeap Developer Authorization & Elevation Management Project Management API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"

{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoodLeap Developer Authorization & Elevation Management Loan Status API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Loan Status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Loans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/loans",
            "params": [
              {
                "name": "referenceNumber",
                "value": "",
                "type": "query"
              },
              {
                "name": "tags",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a list of loans submitted by the client."
        },
        {
          "info": {
            "name": "Loan by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/loans/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the details of a Loan instance."
        },
        {
          "info": {
            "name": "Loan Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/loans/:id/status",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the current timestamps for the loan. \nThis can include milestones, document signing, approval status and more."
        },
        {
          "info": {
            "name": "Loan Offer Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/loans/:id/offer",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the details of the current offer associated with a loan ID."
        },
        {
          "info": {
            "name": "Loan Timeline",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/loans/:id/timeline",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the loan timeline."
        },
        {
          "info": {
            "name": "Next Available Loan Actions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goodleap.com/posfinancing/rest/v2/loans/:id/actions",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the next actions for a loan."
        }
      ]
    }
  ],
  "bundled": true
}